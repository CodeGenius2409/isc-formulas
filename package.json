{
  "name": "isc-formula-book",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "ISC 2028 formula reference, problem solver, practice and simulators for Physics, Chemistry, Mathematics and Computer Science. Installable, fully offline.",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/migrate-data.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "sizes": "node scripts/report-sizes.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/besley": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "gsap": "^3.15.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "mathjs": "^15.2.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
